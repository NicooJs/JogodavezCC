# Porta local do servidor (a maioria dos provedores de hospedagem sobrescreve isso sozinha)
PORT=3000

# Chave da RAWG (banco de dados de jogos) pra buscar a capa automaticamente.
# Gratuita, crie a sua em https://rawg.io/apidocs
# Sem essa chave, os jogos aparecem sem capa (o resto funciona normalmente).
RAWG_API_KEY=

# Credenciais de um app da Twitch — usadas em dois lugares: (a) login de
# verdade com a Twitch na criação do leilão (obrigatório, é o que confirma
# nome/foto e evita alguém se passar por outro streamer), e (b) buscar
# avatar de doador por nome (cosmético, opcional). Crie um app grátis em
# https://dev.twitch.tv/console. Em "OAuth Redirect URLs", cadastre
# http://localhost:3000/auth/twitch/callback (ajuste a porta se mudar
# PORT abaixo) — em produção, cadastre também a URL real do seu domínio
# (https://SEU-DOMINIO/auth/twitch/callback).
# Sem essas chaves, NÃO dá pra criar leilão novo nenhum (login com a Twitch
# é obrigatório) — leilões já existentes continuam funcionando normalmente.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Segredo pra assinar o cookie de sessão (login com a Twitch, ver
# src/session.js). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Guarde em segredo — quem tiver esse valor consegue forjar sessão logada de
# qualquer conta da Twitch dentro do NOSSO app (mas não na Twitch de
# verdade). Trocar esse valor desloga todo mundo de uma vez (não tem como
# invalidar sessão por sessão nesse design, é a troca proposital).
SESSION_SECRET=

# (Removida: PIXGG_WEBHOOK_SECRET não existe mais como env var global. Cada
# leilão agora gera e guarda o próprio segredo de webhook sozinho, na
# primeira vez que precisa de um -- ver getOrCreateWebhookSecret em
# server.js. Um valor compartilhado entre todos os leilões significava que
# mexer nessa variável no Railway invalidava o webhook de TODOS de uma vez,
# sem erro visível em lugar nenhum.)

# Segredo do dono do site (não de um leilão específico) — usado só pela
# rota de apagar leilão (DELETE /api/admin/leiloes/:id), pra moderação/
# limpeza de leilões de teste sem precisar saber a senha de apresentador de
# cada um. Gere um valor aleatório e mantenha em segredo. Em branco, a rota
# fica desativada (sempre nega, nunca "pula a validação" como o de cima).
SUPER_ADMIN_SECRET=

# String de conexão do Postgres (ver src/pg.js) -- guarda credencial OAuth
# do Mercado Pago e histórico de pagamentos (src/streamersStore.js,
# src/paymentsStore.js). NÃO é onde o catálogo do leilão mora (isso
# continua em JSON, DATA_DIR abaixo). No Railway, aponte pra
# ${{Postgres.DATABASE_URL}} (referência ao serviço Postgres do projeto);
# local, use a DATABASE_PUBLIC_URL do mesmo serviço (a interna só é
# alcançável de dentro da rede do Railway). Rode `node scripts/migrate.js`
# depois de configurar, pra criar as tabelas.
DATABASE_URL=

# Chave de 32 bytes (64 caracteres hex) pra cifrar em repouso os tokens
# OAuth do Mercado Pago guardados no Postgres (ver src/tokenCrypto.js) --
# access_token/refresh_token são credenciais reais, nunca ficam em texto
# puro no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar esse valor invalida TODOS os tokens já guardados (streamers
# precisariam reconectar o Mercado Pago) -- guarde com o mesmo cuidado de
# SESSION_SECRET.
TOKEN_ENCRYPTION_KEY=

# Credenciais da SUA aplicação no painel de desenvolvedor do Mercado Pago
# (mercadopago.com.br/developers/panel > Suas integrações > Criar
# aplicação > tipo "Pagamentos online" > "Checkout Transparente" > API de
# Pagamentos). Usadas pro fluxo de OAuth que conecta a conta MP de cada
# streamer (ver src/mpAuth.js) -- é uma aplicação só pro site inteiro,
# não uma por streamer (quem varia é o token que cada streamer autoriza).
# Em "URLs de redirect" da aplicação, cadastre
# http://localhost:3000/auth/mercadopago/callback (local) e a URL real do
# seu domínio (https://SEU-DOMINIO/auth/mercadopago/callback) em produção.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
