# Porta local do servidor (a maioria dos provedores de hospedagem sobrescreve isso sozinha)
PORT=3000

# Busca de jogo/capa usa a IGDB (banco de dados mantido pela Twitch/Amazon,
# bem mais estável que a RAWG que usávamos antes). Não precisa de chave
# nova nenhuma -- reaproveita as credenciais TWITCH_CLIENT_ID/SECRET
# abaixo (client credentials grant contra id.twitch.tv). Sem essas
# credenciais, os jogos aparecem sem capa (o resto funciona normalmente).

# Chave da TMDB (banco de dados de filmes) -- só usada quando um leilão tá na
# modalidade "filmes" (trocável nas Configurações do apresentador). Gratuita,
# crie a sua em https://www.themoviedb.org/settings/api ("API Key (v3 auth)").
# Sem essa chave, os filmes aparecem sem pôster (mesmo fallback da IGDB).
TMDB_API_KEY=

# Credenciais de um app da Twitch — usadas em três lugares: (a) login de
# verdade com a Twitch na criação do leilão (obrigatório, é o que confirma
# nome/foto e evita alguém se passar por outro streamer), (b) buscar
# avatar de doador por nome (cosmético, opcional), e (c) autenticar na
# IGDB pra busca de jogo/capa (ver src/igdbApi.js). Crie um app grátis em
# https://dev.twitch.tv/console. Em "OAuth Redirect URLs", cadastre
# http://localhost:3000/auth/twitch/callback (ajuste a porta se mudar
# PORT abaixo) — em produção, cadastre também a URL real do seu domínio
# (https://SEU-DOMINIO/auth/twitch/callback).
# Sem essas chaves, NÃO dá pra criar leilão novo nenhum (login com a Twitch
# é obrigatório) — leilões já existentes continuam funcionando normalmente.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Segredo pra assinar o cookie de sessão (login com a Twitch, ver
# src/session.js). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Guarde em segredo — quem tiver esse valor consegue forjar sessão logada de
# qualquer conta da Twitch dentro do NOSSO app (mas não na Twitch de
# verdade). Trocar esse valor desloga todo mundo de uma vez (não tem como
# invalidar sessão por sessão nesse design, é a troca proposital).
SESSION_SECRET=

# Segredo do dono do site (não de um leilão específico) — usado só pela
# rota de apagar leilão (DELETE /api/admin/leiloes/:id), pra moderação/
# limpeza de leilões de teste sem precisar saber a senha de apresentador de
# cada um. Gere um valor aleatório e mantenha em segredo. Em branco, a rota
# fica desativada (sempre nega, nunca "pula a validação" como o de cima).
SUPER_ADMIN_SECRET=

# String de conexão do Postgres (ver src/pg.js) -- guarda identidade dos
# streamers (src/streamersStore.js), chave Pix de saque
# (src/streamerPixKeysStore.js), ledger de custódia (src/ledgerStore.js),
# histórico de pagamentos (src/paymentsStore.js) e uma cópia de segurança
# periódica do estado de cada leilão (src/stateBackup.js). O catálogo/
# eventos do leilão em si continuam morando em JSON (DATA_DIR abaixo, com
# Volume persistente no Railway) -- o Postgres aqui é rede de segurança,
# não fonte de verdade pro leilão. No Railway, aponte pra
# ${{Postgres.DATABASE_URL}} (referência ao serviço Postgres do projeto);
# local, use a DATABASE_PUBLIC_URL do mesmo serviço (a interna só é
# alcançável de dentro da rede do Railway). Rode `node scripts/migrate.js`
# depois de configurar, pra criar as tabelas.
DATABASE_URL=

# TOKEN_ENCRYPTION_KEY: chave de 32 bytes (64 caracteres hex) pra cifrar em
# repouso credenciais de terceiro guardadas no Postgres (hoje: clientSecret
# do pixgg.com por streamer, src/streamerPixggStore.js). Gere com
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# TOKEN_ENCRYPTION_KEY_OLD (opcional, separado por vírgula): chave(s)
# antiga(s), só usadas pra decifrar durante uma rotação de chave.
TOKEN_ENCRYPTION_KEY=

# Ambiente ativo da Efí: "homologacao" (padrão, sandbox) ou "producao"
# (dinheiro real). Trocar aqui muda o site inteiro sem redeploy -- só
# mude pra "producao" depois de confirmar conta aprovada, chave Pix e
# pix.send liberados (ver docs/STATUS-EFI.md).
EFI_ENV=homologacao

# Client ID/Secret de cada ambiente, gerados na aplicação Pix da sua Conta
# Efí (API > Aplicações). Um par por ambiente (Homologação/Produção).
EFI_CLIENT_ID_HOMOLOGACAO=
EFI_CLIENT_SECRET_HOMOLOGACAO=
EFI_CLIENT_ID_PRODUCAO=
EFI_CLIENT_SECRET_PRODUCAO=

# Certificado .p12 de cada ambiente (API > Meus Certificados), convertido
# pra base64 (nunca escrito em disco no servidor):
#   base64 -w0 caminho/do/certificado.p12
EFI_CERT_HOMOLOGACAO_BASE64=
EFI_CERT_PRODUCAO_BASE64=

# Chave Pix da Conta Master que recebe as doações e envia os saques, uma
# por ambiente (cadastrada na Conta Digital da Efí, fora da área de API).
EFI_CHAVE_PIX_HOMOLOGACAO=
EFI_CHAVE_PIX_PRODUCAO=

# Segredo aleatório embutido na URL do webhook (a Efí não assina o
# webhook com HMAC, ver src/efiWebhook.js). Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Cadastre o webhook apontando pra
# https://SEU-DOMINIO/webhooks/efi/pix/ESSE-VALOR via efiApi.registrarWebhook.
EFI_WEBHOOK_SECRET=

# Opcional: IPs conhecidos da Efí pra log/alerta (não bloqueia sozinho,
# ver src/efiWebhook.js). Separado por vírgula. Deixe em branco pra usar
# a lista padrão do código.
EFI_WEBHOOK_IPS=
